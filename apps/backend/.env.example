# ─── Database ────────────────────────────────────────────────────────────────
# Get a free PostgreSQL database at https://neon.tech or install locally
DATABASE_URL="postgresql://username:password@localhost:5432/numero_uno_pg"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:19006,exp://localhost:19000"

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Cloudflare R2 (file storage) ────────────────────────────────────────────
# Get from Cloudflare Dashboard → R2 → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="numero-uno-pg-files"
R2_PUBLIC_URL="https://your-bucket.your-account.r2.cloudflarestorage.com"

# ─── Anthropic Claude Vision API (Aadhaar OCR) ────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Razorpay (payments) ─────────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ─── Gupshup (WhatsApp notifications) ────────────────────────────────────────
# Get from https://www.gupshup.io
GUPSHUP_API_KEY="your-gupshup-api-key"
GUPSHUP_APP_NAME="your-gupshup-app-name"
GUPSHUP_SOURCE_NUMBER="+91XXXXXXXXXX"

# ─── Encryption (for Aadhaar number storage) ─────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-32-byte-hex-encryption-key"
