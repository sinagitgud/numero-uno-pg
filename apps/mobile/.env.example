# Backend API URL
# For local development: use your computer's local IP (not localhost) when testing on a phone
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
# For production: EXPO_PUBLIC_API_URL=https://your-backend.railway.app
EXPO_PUBLIC_API_URL=http://localhost:3000

# Firebase configuration
# Get from Firebase Console → Project Settings → Your apps → Web app config
EXPO_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
EXPO_PUBLIC_FIREBASE_APP_ID="1:xxx:web:xxx"

# Razorpay (test key for development)
EXPO_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
