{
  "name": "numero-uno-pg",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/mobile",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "backend": "npm run dev --workspace=apps/backend",
    "mobile": "npm run start --workspace=apps/mobile",
    "web": "npm run dev --workspace=apps/web",
    "dev": "concurrently \"npm run backend\" \"npm run mobile\"",
    "dev:web": "concurrently \"npm run backend\" \"npm run web\"",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:studio": "npm run db:studio --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend",
    "db:migrate:web": "cd apps/backend && npx prisma migrate dev --name phase6_inquiries"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
